# ============================================
# Docker Ignore - Puppet Master v3
# ============================================

# Dependencies (reinstalled in container)
node_modules
.pnpm-store

# Build outputs (rebuilt in container)
.output
build
.nuxt
dist
.deploy

# Development files
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/
!README.md

# Environment files (secrets should be injected at runtime)
.env
.env.*
!.env.example

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test files
coverage
*.test.ts
tests/
vitest.config.ts
playwright.config.ts
test-results/
e2e-playwright/

# Audit/misc dev dirs (audit N-14 — keep the build context lean)
# NOTE: messages/ and project.inlang/ are intentionally NOT excluded — the
# Paraglide plugin (vite.config.ts) compiles them into src/lib/paraglide
# during `npm run build`, so a clean container build needs the same inputs
# as local development.
ansible/
.kilo/
.husky/
.nocowboy/
contributing/
legal/
project/

# Local data (should be mounted as volumes)
data/
*.db
*.sqlite

# Uploads (should be mounted as volume)
public/uploads/*
!public/uploads/.gitkeep

# Kamal/deploy files
.kamal
deploy.yml

# Logs
*.log
npm-debug.log*

# TypeScript build info
*.tsbuildinfo

# Temporary files
tmp/
temp/
