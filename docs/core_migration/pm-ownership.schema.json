{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Puppet Master Ownership Manifest",
  "type": "object",
  "required": ["version", "owners", "paths"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "owner", "status"],
        "properties": {
          "path": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "enum": ["canonical", "candidate", "deprecated", "conflict"]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
