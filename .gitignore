# ══════════════════════════════════════════════════════════════
# FRAMEWORK BUILD OUTPUTS
# ══════════════════════════════════════════════════════════════
.output/
.nuxt/
.svelte-kit/
.nitro/
.cache/
dist/
.data/

# ══════════════════════════════════════════════════════════════
# DEPENDENCIES
# ══════════════════════════════════════════════════════════════
node_modules/

# ══════════════════════════════════════════════════════════════
# ENVIRONMENT & SECRETS (never commit!)
# ══════════════════════════════════════════════════════════════
.env
.env.*
!.env.example

# Generated Ansible deployment artifacts (contain secrets / server access)
ansible/inventory.yml
ansible/deploy-vars.yml
ansible/known_hosts
!ansible/inventory.example.yml

# Generated deploy runtime bundles
.deploy/

# Local PM setup/deploy state. Contains no secrets, but is workstation-specific.
.pm-deploy-state.json

# ══════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════
# SQLite database and WAL files
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# ══════════════════════════════════════════════════════════════
# USER UPLOADS
# ══════════════════════════════════════════════════════════════
public/uploads/*
!public/uploads/.gitkeep

# ══════════════════════════════════════════════════════════════
# TESTING
# ══════════════════════════════════════════════════════════════
# Vitest
coverage/

# Playwright
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ══════════════════════════════════════════════════════════════
# LOGS & DEBUG
# ══════════════════════════════════════════════════════════════
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lighthouse_report/

# ══════════════════════════════════════════════════════════════
# IDE & EDITORS
# ══════════════════════════════════════════════════════════════
.idea/
.fleet/
*.swp
*.swo
*~

# VSCode - ignore workspace but keep shared settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ══════════════════════════════════════════════════════════════
# OS FILES
# ══════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ══════════════════════════════════════════════════════════════
# TYPESCRIPT
# ══════════════════════════════════════════════════════════════
*.tsbuildinfo

# ══════════════════════════════════════════════════════════════
# TAUSIK RUNTIME
# ══════════════════════════════════════════════════════════════
.tausik/
.tausik-lib/
.opencode/

# ══════════════════════════════════════════════════════════════
# BUILD OUTPUTS (adapter-node)
# ══════════════════════════════════════════════════════════════
/build/

# ══════════════════════════════════════════════════════════════
# AI AGENT CACHE / MONITORING DATA
# ══════════════════════════════════════════════════════════════
# Agent config directories (.kilo/, .claude/, .qwen/, etc.) are TRACKED.
# Only block their runtime caches and monitoring data directories.
.claude-monitor/
.claude-data/
.qwen-data/
.cache/

# ══════════════════════════════════════════════════════════════
# PMNATIVE BOOTSTRAP (LOCAL UNTIL V1 EXTRACT)
# ══════════════════════════════════════════════════════════════
pm-native/

# Generated greenfield intake bundles may contain client concept material.
project/init/generated/

# ══════════════════════════════════════════════════════════════
# PARAGLIDE (i18n — generated at build time by vite plugin)
# ══════════════════════════════════════════════════════════════
src/lib/paraglide/

# i18n/db-translations.json — committed artifact (generated by export-paraglide-messages.ts)

# Stray installer/download archives
archive-*/
.crush/
