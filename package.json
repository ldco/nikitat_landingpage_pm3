{
  "name": "puppetmaster3",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/env-bootstrap.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "predb:seed": "node scripts/env-bootstrap.mjs",
    "db:seed": "tsx --env-file=.env src/lib/server/db/seed.ts",
    "predb:reset": "node scripts/env-bootstrap.mjs",
    "db:reset": "rm -f data/sqlite.db && drizzle-kit push && tsx --env-file=.env src/lib/server/db/seed.ts",
    "i18n:export": "tsx scripts/export-paraglide-messages.ts",
    "db:studio": "drizzle-kit studio",
    "assets:favicons": "node scripts/generate-favicons.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:secrets": "bash scripts/deploy-secrets.sh",
    "presetup": "node scripts/env-bootstrap.mjs",
    "setup": "bash scripts/setup.sh",
    "rollback": "bash scripts/rollback.sh",
    "deploy:logs": "bash scripts/deploy-logs.sh",
    "git:push": "bash scripts/git-push.sh",
    "git:remote:setup": "bash scripts/git-remote-setup.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "validate:pm3": "node scripts/pm3-validator.mjs",
    "validate:pm3:strict": "node scripts/pm3-validator.mjs --check-strict",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/heebo": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/geologica": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@inlang/paraglide-sveltekit": "^0.16.1",
    "@inlang/plugin-message-format": "^4.4.0",
    "@sentry/node": "^10.70.0",
    "@sentry/sveltekit": "^10.70.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.20.0",
    "@tabler/icons-svelte": "^3.45.0",
    "better-sqlite3": "^12.5.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "gsap": "^3.15.0",
    "matter-js": "^0.20.0",
    "nodemailer": "^7.0.11",
    "otpauth": "^9.4.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "svelte": "^5.25.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.65.0",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^3.22.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte-check": "^4.1.0",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "undici": "^7.28.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.18.20": true
  },
  "lint-staged": {
    "*.{svelte,ts,js,mjs,css}": [
      "node scripts/pm3-validator.mjs",
      "eslint --no-warn-ignored --max-warnings=0"
    ]
  }
}
