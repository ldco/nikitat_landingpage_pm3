{
  "name": "app",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "mkdir -p data",
    "prebuild": "mkdir -p data && npm run assets:launch && npm run check:launch-assets && npm run assets:optimize:incremental",
    "build": "nuxt build",
    "dev": "bash scripts/docker-dev.sh",
    "dev:host": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "mkdir -p data && drizzle-kit migrate",
    "db:push": "mkdir -p data && drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx server/database/seed.ts",
    "db:reset": "rm -f data/sqlite.db && npm run db:migrate && npm run db:seed",
    "admin:passwords:rotate": "node scripts/rotate-admin-passwords.mjs --generate --write-env --apply",
    "init": "test -d node_modules || npm install; node --import tsx scripts/init-cli.ts",
    "init:green": "test -d node_modules || npm install; node --import tsx scripts/init-green.ts",
    "pm-init-green": "npx tsx scripts/init-green.ts",
    "test": "npm run test:staged",
    "test:staged": "npm run test:unit && npm run test:api",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/server/**/*.test.ts tests/components/**/*.test.ts tests/composables/**/*.test.ts tests/pm-core/**/*.test.ts",
    "test:api": "bash scripts/run-api-tests.sh",
    "test:api:single": "bash scripts/run-api-tests.sh",
    "test:e2e": "vitest run tests/e2e/*.test.ts",
    "test:e2e:playwright": "playwright test",
    "test:e2e:playwright:ui": "playwright test --ui",
    "playwright:install": "playwright install",
    "generate:favicons": "create-favicon public/favicon.svg public --overwrite --no-manifest",
    "setup": "bash scripts/setup.sh",
    "setup:resume": "bash scripts/setup.sh --resume",
    "deploy:secrets": "bash scripts/deploy-secrets.sh",
    "deploy": "bash scripts/deploy.sh",
    "rollback": "bash scripts/rollback.sh",
    "deploy:logs": "bash scripts/deploy-logs.sh",
    "deploy:shell": "bash scripts/deploy-shell.sh",
    "deploy:sync-local-data": "bash scripts/deploy-sync-local-data.sh",

    "internal:server:provision": "ansible-galaxy collection install -r ansible/requirements.yml && ansible-playbook -i ansible/inventory.yml ansible/provision-shared.yml",
    "internal:server:provision:check": "ansible-galaxy collection install -r ansible/requirements.yml && ansible-playbook -i ansible/inventory.yml ansible/provision-shared.yml --check",
    "docker:build": "docker build -t puppetmaster2 .",
    "docker:dev": "bash scripts/docker-dev.sh",
    "docker:dev:clean": "bash scripts/docker-dev.sh --clean-volumes",
    "docker:run": "docker run -p 3000:3000 --env-file .env puppetmaster2",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "workflow:switch": "node --import tsx scripts/switch-workflow.ts",
    "workflow:info": "node --import tsx scripts/workflow-info.ts",
    "audit:api-envelope": "node scripts/audit-api-envelope.mjs",
    "audit:api-envelope:enforce": "node scripts/audit-api-envelope.mjs --enforce",
    "check-doc-entrypoints": "node scripts/check-doc-entrypoints.mjs",
    "check-doc-entrypoints:enforce": "node scripts/check-doc-entrypoints.mjs --enforce",
    "check:launch-assets": "node scripts/check-launch-assets.mjs",
    "check:launch-assets:enforce": "node scripts/check-launch-assets.mjs --enforce",
    "assets:launch": "node scripts/generate-launch-assets.mjs",
    "pm-new-project": "bash scripts/pm-new-project.sh",
    "pm-vanilla": "bash scripts/pm-vanilla.sh",
    "check:versions": "node scripts/check-framework-versions.mjs",
    "check:pm-ownership": "node scripts/check-pm-ownership.mjs",
    "lint:css-tokens": "node scripts/lint-css-tokens.js",
    "lint:css-tokens:enforce": "node scripts/lint-css-tokens.js && exit 0",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:optimize:incremental": "node scripts/optimize-assets.mjs",
    "assets:optimize:full": "node scripts/optimize-assets.mjs --full"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.952.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/node": "^9.17.0",
    "@sentry/vue": "^9.17.0",
    "@squircle-js/vue": "^0.1.0",
    "@types/adm-zip": "^0.5.7",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/ioredis": "^4.28.10",
    "@types/matter-js": "^0.20.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "^0.184.1",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "gsap": "^3.15.0",
    "hamburgers": "^1.2.1",
    "ioredis": "^5.9.1",
    "matter-js": "^0.20.0",
    "nodemailer": "^7.0.11",
    "nuxt": "^4.4.7",
    "otpauth": "^9.4.0",
    "pinia": "^3.0.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "three": "^0.184.0",
    "unplugin-icons": "^22.5.0",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.17.0",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@iconify/json": "^2.2.418",
    "@nuxt/test-utils": "^3.21.0",
    "@nuxtjs/critters": "^0.9.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^8.5.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/addon-interactions": "^8.5.0",
    "@storybook/blocks": "^8.5.0",
    "@storybook/test": "^8.5.0",
    "@storybook/vue3": "^8.5.0",
    "@storybook/vue3-vite": "^8.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vite-pwa/nuxt": "^1.1.0",
    "@vue/test-utils": "^2.4.6",
    "create-favicon": "^2.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^20.0.0",
    "lighthouse": "^13.0.1",
    "postcss-preset-env": "^10.5.0",
    "prettier": "^3.4.2",
    "storybook": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.2.7"
  }
}
