{
  "name": "puppetmaster3",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/lib/server/db/seed.ts",
    "db:reset": "rm -f data/sqlite.db && drizzle-kit push && tsx src/lib/server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy": "bash scripts/deploy.sh",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/geologica": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@inlang/paraglide-sveltekit": "^0.16.1",
    "@inlang/plugin-message-format": "^4.4.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.20.0",
    "better-sqlite3": "^12.5.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "gsap": "^3.15.0",
    "matter-js": "^0.20.0",
    "nodemailer": "^7.0.11",
    "otpauth": "^9.4.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "svelte": "^5.25.0",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.18.20": true
  }
}
