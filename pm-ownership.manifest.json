{
  "$schema": "./docs/core_migration/pm-ownership.schema.json",
  "version": 1,
  "description": "Initial Puppet Master ownership scaffold. Paths are intentionally broad for the first no-legacy Plan 1 migration phase.",
  "owners": {
    "core": {
      "description": "Stable PM platform runtime: config loading, security, auth/session primitives, RBAC, audit, setup, base CSS, shared utilities."
    },
    "site-shell": {
      "description": "Public website shell, navigation, footer/header behavior, public page rendering."
    },
    "admin-shell": {
      "description": "PM management shell: admin layouts, admin pages, admin APIs, settings/users/audit surfaces."
    },
    "app-shell": {
      "description": "Authenticated product/dashboard shell for app-mode projects."
    },
    "plugin-blog": {
      "description": "Blog public/admin functionality."
    },
    "plugin-pricing": {
      "description": "Pricing public/admin functionality."
    },
    "plugin-contact": {
      "description": "Contact form, contact settings, notifications, and related public/admin functionality."
    },
    "plugin-scrollytelling": {
      "description": "Scene-based storytelling and motion functionality."
    },
    "plugin-portfolio": {
      "description": "Portfolio/project showcase functionality."
    },
    "plugin-faq": {
      "description": "FAQ public/admin functionality."
    },
    "plugin-team": {
      "description": "Team public/admin functionality."
    },
    "plugin-testimonials": {
      "description": "Testimonials public/admin functionality."
    },
    "plugin-clients": {
      "description": "Clients/logos public/admin functionality."
    },
    "plugin-features": {
      "description": "Feature cards public/admin functionality."
    },
    "plugin-media": {
      "description": "Media upload, storage-facing UI/API, and media delivery functionality."
    },
    "plugin-analytics": {
      "description": "Analytics capture, performance telemetry, and analytics integrations."
    },
    "undecided": {
      "description": "Temporary bucket for mixed paths that require inspection before moving."
    },
    "project": {
      "description": "Current product code, content, branding, project config, custom APIs, custom schema, and client-specific assets."
    }
  },
  "paths": [
    {
      "path": "project/puppet-master.config.ts",
      "owner": "project",
      "status": "canonical"
    },
    {
      "path": "pm-core/app/types/**",
      "owner": "core",
      "status": "conflict",
      "notes": "Shared type contracts live in core, but modules.ts still contains plugin route/admin metadata. Split pure module config contracts from shell/plugin metadata before treating this path as canonical core."
    },
    {
      "path": "pm-core/app/composables/usePmConfig.ts",
      "owner": "core",
      "status": "canonical"
    },
    {
      "path": "pm-core/app/composables/useConfig.ts",
      "owner": "core",
      "status": "canonical"
    },
    {
      "path": "pm-core/app/composables/useSafeConfig.ts",
      "owner": "core",
      "status": "canonical"
    },
    {
      "path": "pm-core/app/composables/useModule.ts",
      "owner": "core",
      "status": "conflict",
      "notes": "Core access wrapper over current module registry, currently coupled to plugin route/admin metadata. Do not use this as proof that plugin route/admin metadata is ready to move."
    },
    {
      "path": "app/composables/apiFetch.ts",
      "owner": "core",
      "status": "candidate",
      "notes": "Core API transport primitive. Move with useCsrf."
    },
    {
      "path": "app/composables/useCsrf.ts",
      "owner": "core",
      "status": "candidate",
      "notes": "Core CSRF primitive. Move with apiFetch."
    },
    {
      "path": "app/composables/useAuth.ts",
      "owner": "core",
      "status": "candidate",
      "notes": "Core auth state candidate; inspect admin/app coupling before moving."
